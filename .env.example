# Google AI Studio (Gemini) API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-flash-lite-latest

# Локальний Viber Desktop (Windows)
VIBER_DOWNLOADS_DIR=C:/Users/YourUser/Documents/ViberDownloads
VIBER_PC_DIR=
# Ротація старих фото з ViberDownloads (0 = вимкнено; якщо VIBER_ARCHIVE_DIR порожній - видаляє, інакше переносить в архів)
VIBER_RETENTION_DAYS=21
VIBER_ARCHIVE_DIR=

# Резервні / майбутні ключі (опційно)
OPENAI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./storage/telegram_user.session
TELEGRAM_DOWNLOADS_DIR=./storage/telegram_downloads
TELEGRAM_LOOKBACK_HOURS=72
# Опційно: список ID або частин назв груп через кому (якщо порожньо - читаються всі групові чати)
TELEGRAM_ALLOWED_CHATS=

# WhatsApp (WAHA)
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=

# Налаштування збереження та батчингу
FACILITIES_JSON_PATH=./data/facilities.json
STORAGE_ROOT=./storage
# Опційно: мережева папка сервера (коли будемо готові лити на сервер, наприклад \\ramedas.local\Public)
# REPORTS_OUTPUT_DIR=\\ramedas.local\Public
DOCUMENT_DATE_MAX_AGE_DAYS=14
BATCH_WINDOW_SECONDS=45
SILENT_MODE=true
TECH_ALERT_CHAT_ID=

# Моніторинг активності у робочий час та алерти (0 = вимкнути алерт тиші)
WORK_HOURS_START=09:00
WORK_HOURS_END=18:00
WORK_DAYS=1,2,3,4,5
SILENCE_ALERT_MINUTES=120
ALERT_COOLDOWN_MINUTES=60
